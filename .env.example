# Skopiuj ten plik do .env i uzupełnij wartości. .env nie zastępuje plików
# sekretów: Client secret, klucz szyfrowania i token agenta przygotuj w katalogu
# secrets zgodnie z sekcją „Instalacja i uruchomienie” w README.md.

# Publiczny adres HTTPS callbacku OAuth: wybierz domenę i ścieżkę obsługiwane
# przez swój zewnętrzny gateway/reverse proxy. Ścieżka musi kończyć się na
# /oauth/google/callback; opcjonalny wcześniejszy prefiks zależy od Twojej trasy.
# W Google Cloud Console → Google Auth Platform → Clients → klient Web application
# wpisz dokładnie ten sam adres w Authorized redirect URIs. Google go nie generuje.
# HTTP jest dozwolony tylko dla localhost lub 127.0.0.1 do testów lokalnych.
OAUTH_REDIRECT_URL=https://calendar.example.org/google-workspace/oauth/google/callback

# Obraz aplikacji dla Docker Compose. Szablon pobrany z release zawiera już
# adres i tag obrazu tego wydania w odpowiednim registry; pozostaw tę wartość.
# Przy budowaniu ze źródeł użyj lokalnego tagu z polecenia docker build.
GATEWAY_IMAGE=google-workspace-gateway:local

# Identyfikator klienta OAuth, nie Client secret. Skopiuj Client ID z Google
# Cloud Console → Google Auth Platform → Clients → wybrany klient Web application.
# Użyj klienta z tego samego projektu, w którym włączono Calendar API i Tasks API.
GOOGLE_CLIENT_ID=UZUPELNIJ.apps.googleusercontent.com

# Adresy kont Google, którym chcesz pozwolić korzystać z panelu; wpisz je sam.
# Oddziel adresy przecinkami; spacje wokół nich i wielkość liter są ignorowane.
# W trybie External + Testing dodaj je także w Google Auth Platform → Audience
# → Test users; w trybie Internal muszą należeć do organizacji Workspace.
ALLOWED_EMAILS=ty@example.com,druga.osoba@example.com

# Numeryczny GID grupy będącej właścicielem plików secrets/ na hoście.
# Sprawdź go np. poleceniem: stat -c '%g' secrets/encryption_key
# Gateway otrzyma tę dodatkową grupę; pliki muszą być dla niej czytelne
# (np. chmod 640). Używaj zaufanej grupy, bez dostępu dla innych użytkowników.
# Domyślnie 1000; przy rootless Dockerze/mapowaniu UID/GID patrz README.
SECRETS_GID=1000

# Adres interfejsu VPS, na którym Docker publikuje HTTP gatewaya. Wybierz go
# według swojej sieci: 127.0.0.1 dla proxy na tym samym hoście; dla proxy poza
# hostem użyj osiągalnego interfejsu prywatnego i ogranicz dostęp firewallem.
# To nie jest domena ani adres callbacku OAuth; publiczny HTTPS zapewnia proxy.
BIND_ADDRESS=127.0.0.1

# Wolny port HTTP na VPS, do którego Twój zewnętrzny proxy kieruje ruch.
# Wybierz go sam; domyślnie 8765. Wewnątrz kontenera aplikacja używa portu 8765.
GATEWAY_PORT=8765

# Ścieżka pliku logu wewnątrz kontenera, wybierana przez administratora.
# Domyślne /data/gateway.log znajduje się w trwałym wolumenie gateway_data;
# inna ścieżka musi być zapisywalna dla użytkownika aplikacji w kontenerze.
LOG_FILE=/data/gateway.log

# Limit rozmiaru logu w bajtach przed rotacją, ustawiany przez administratora.
# Domyślnie 10485760 (10 MiB), zakres 1024–1073741824; jedna kopia z końcówką .1.
LOG_MAX_BYTES=10485760
