# Exact public OAuth callback URL; your external HTTPS gateway must route its path to this app.
OAUTH_REDIRECT_URL=https://calendar.example.org/google-workspace/oauth/google/callback
GATEWAY_IMAGE=google-workspace-gateway:local
GOOGLE_CLIENT_ID=UZUPELNIJ.apps.googleusercontent.com
ALLOWED_EMAILS=ty@example.com

# Host-side HTTP port. Keep loopback if the reverse proxy runs on this VPS.
BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8765
